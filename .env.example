# 站点 canonical URL（无尾斜杠）
# 生产环境在 Vercel 中必配，用于 RSS / sitemap 等绝对链接
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 可选：强制显示/隐藏草稿（一般无需配置）
# 开发默认显示草稿；生产构建 prebuild 使用 SHOW_DRAFTS=0
# SHOW_DRAFTS=1

# 可选：首页“最近在看”（服务端读取 WebHTV，不要使用 NEXT_PUBLIC_ 前缀）
WEBHTV_PLAYBACK_URL=https://webhtv.zealerg.top/api/playback/sync
# WEBHTV_PLAYBACK_TOKEN=
# WEBHTV_PLAYBACK_CONFIG_KEY=

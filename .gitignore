# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# project
.superpowers
public/search-index.json

# local agent skills (npx skills add) — do not commit
.agents/
.claude/
.codex/
.cursor/skills/
skills-lock.json

# Personal Obsidian content (local only; ship example content only)
content/posts/*
!content/posts/hello-world.md
!content/posts/draft-hidden.md
!content/posts/markdowntest.md
content/glimpses/memos.md
content/glimpses/2026-05-yushan.md
content/friends/*
!content/friends/example-blog.md
content/.DS_Store

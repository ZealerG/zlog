# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
.playwright-mcp/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
.env*.local
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# project
.superpowers
public/search-index.json
tmp/

# local agent skills (npx skills add) — do not commit
.agents/
.claude/
.codex/
.cursor/skills/
skills-lock.json

# content cache (fingerprint metadata)
.content-cache/

# private build-time content graph snapshot (regenerated on each build)
.content-graph/

# Content is tracked (single personal repo). Keep junk out of content/.
content/.DS_Store
content/**/.DS_Store

# Local vault extras — not site content (may hold secrets / scratch)
notes/
copilot/

# Obsidian vault config + plugins (local; may contain API keys)
.obsidian/
.obsidian.bak-*/

# old planning docs
docs/superpowers/
